{
	"name": "incremental-writing-ollama",
	"version": "1.0.0",
	"description": "Incremental writing queue and local Ollama writing assistants for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"bump": "node version-bump.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"incremental-writing",
		"spaced-repetition",
		"ollama",
		"mistral-nemo",
		"writing"
	],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"author": "Samarth"
}
